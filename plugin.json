{
    "id": "discordVoice",
    "name": "Discord Voice Widget",
    "description": "Show Discord voice channel participants in DankBar with speaking/mute indicators and voice controls. Requires DMS 1.5+.",
    "version": "1.4.0",
    "author": "PandorasFox",
    "type": "widget",
    "capabilities": [
        "dankbar-widget",
        "discord",
        "voice"
    ],
    "component": "./DiscordVoiceWidget.qml",
    "components": {
        "widget": "./DiscordVoiceWidget.qml",
        "daemon": "./DiscordVoiceDaemon.qml"
    },
    "icon": "headset_mic",
    "settings": "./DiscordVoiceSettings.qml",
    "requires": [
        "python3"
    ],
    "permissions": [
        "settings_read",
        "settings_write"
    ]
}
